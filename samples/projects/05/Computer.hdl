/**
 * The Hack computer: CPU, data memory and instruction memory. Set reset
 * to restart the program in ROM.
 */
CHIP Computer {
    IN reset;

    PARTS:
    CPU(inM=memOut, instruction=instruction, reset=reset, outM=outM, writeM=writeM, addressM=address, pc=pc);
    Memory(in=outM, load=writeM, address=address, out=memOut);
    ROM32K(address=pc, out=instruction);
}
