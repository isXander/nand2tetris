/**
 * The Hack ALU: computes one of 18 functions of x and y selected by
 * zx, nx, zy, ny, f and no. zr is 1 when out == 0; ng is 1 when out < 0.
 */
CHIP ALU {
    IN x[16], y[16], zx, nx, zy, ny, f, no;
    OUT out[16], zr, ng;

    PARTS:
    Mux16(a=x, b=false, sel=zx, out=x1);
    Not16(in=x1, out=notX1);
    Mux16(a=x1, b=notX1, sel=nx, out=x2);
    Mux16(a=y, b=false, sel=zy, out=y1);
    Not16(in=y1, out=notY1);
    Mux16(a=y1, b=notY1, sel=ny, out=y2);
    And16(a=x2, b=y2, out=xAndY);
    Add16(a=x2, b=y2, out=xPlusY);
    Mux16(a=xAndY, b=xPlusY, sel=f, out=result);
    Not16(in=result, out=notResult);
    Mux16(a=result, b=notResult, sel=no, out=out, out[15]=ng, out[0..7]=low, out[8..15]=high);
    Or8Way(in=low, out=anyLow);
    Or8Way(in=high, out=anyHigh);
    Or(a=anyLow, b=anyHigh, out=nonZero);
    Not(in=nonZero, out=zr);
}
