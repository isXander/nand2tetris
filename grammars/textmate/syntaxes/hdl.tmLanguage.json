{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nand2Tetris HDL",
  "scopeName": "source.hdl.nand2tetris",
  "patterns": [
    { "include": "#comments" },
    { "include": "#chip" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.hdl",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "captures": { "0": { "name": "punctuation.definition.comment.hdl" } }
        },
        {
          "name": "comment.block.hdl",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": { "0": { "name": "punctuation.definition.comment.hdl" } }
        },
        {
          "name": "comment.line.double-slash.hdl",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.hdl" } }
        }
      ]
    },
    "chip": {
      "begin": "\\b(CHIP)\\b\\s*([A-Za-z_][A-Za-z0-9_]*)?",
      "beginCaptures": {
        "1": { "name": "keyword.other.chip.hdl" },
        "2": { "name": "entity.name.type.chip.hdl" }
      },
      "end": "(?<=\\})",
      "patterns": [
        { "include": "#comments" },
        {
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.block.begin.hdl" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.block.end.hdl" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#pin-section" },
            { "include": "#parts" },
            { "include": "#builtin" },
            { "include": "#clocked" },
            { "include": "#part" }
          ]
        }
      ]
    },
    "pin-section": {
      "begin": "\\b(IN|OUT)\\b",
      "beginCaptures": { "1": { "name": "keyword.other.section.hdl" } },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.hdl" } },
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
          "name": "variable.parameter.pin.hdl"
        },
        {
          "match": "(\\[)\\s*(\\d+)\\s*(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.width.begin.hdl" },
            "2": { "name": "constant.numeric.width.hdl" },
            "3": { "name": "punctuation.definition.width.end.hdl" }
          }
        },
        { "match": ",", "name": "punctuation.separator.comma.hdl" }
      ]
    },
    "parts": {
      "match": "\\b(PARTS)\\s*(:)",
      "captures": {
        "1": { "name": "keyword.other.section.hdl" },
        "2": { "name": "punctuation.separator.colon.hdl" }
      }
    },
    "builtin": {
      "match": "\\b(BUILTIN)\\b\\s*([A-Za-z_][A-Za-z0-9_]*)?\\s*(;)?",
      "captures": {
        "1": { "name": "keyword.other.builtin.hdl" },
        "2": { "name": "entity.name.function.builtin.hdl" },
        "3": { "name": "punctuation.terminator.hdl" }
      }
    },
    "clocked": {
      "begin": "\\b(CLOCKED)\\b",
      "beginCaptures": { "1": { "name": "keyword.other.clocked.hdl" } },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.hdl" } },
      "patterns": [
        { "include": "#comments" },
        { "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b", "name": "variable.parameter.pin.hdl" },
        { "match": ",", "name": "punctuation.separator.comma.hdl" }
      ]
    },
    "part": {
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "entity.name.type.part.hdl" },
        "2": { "name": "punctuation.section.parens.begin.hdl" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.parens.end.hdl" } },
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:\\[[^\\]]*\\])?\\s*=)",
          "name": "variable.other.property.formal-pin.hdl"
        },
        { "match": "=", "name": "keyword.operator.assignment.hdl" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.hdl" },
        { "include": "#selector" },
        { "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b", "name": "variable.other.signal.hdl" },
        { "match": ",", "name": "punctuation.separator.comma.hdl" }
      ]
    },
    "selector": {
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.definition.selector.begin.hdl" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.definition.selector.end.hdl" } },
      "patterns": [
        { "match": "\\d+", "name": "constant.numeric.index.hdl" },
        { "match": "\\.\\.", "name": "keyword.operator.range.hdl" }
      ]
    }
  }
}
